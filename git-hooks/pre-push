#!/bin/sh
# Globalny pre-push (PG): blokuje BEZPOSREDNI push na main/master w projektach
# STANDARD (nowy flow: branch -> PR -> CI+review -> merge).
# Przechodza: stare projekty Lovable (lovable-tagger w package.json), tagi,
# inne branche, oraz awaryjnie: ALLOW_MAIN=1 git push


# Cudza galaz (retro 2026-09-06, petla 11): push na galaz, ktora w ciagu 24 h dostala commit z innego adresu niz moj,
# to wejscie w cudza prace (rownolegle sesje). Tylko OSTRZEZENIE, nie blokuje; wylaczenie: ALLOW_FOREIGN_BRANCH=1.
# Refy pushowane czytamy ze stdin RAZ do zmiennej, zeby reszta hooka mogla z nich korzystac.
PUSH_REFS="$(cat)"
# Audyt obejsc (landscape #5): kazde ustawione ALLOW_* = wpis `bypass` w ~/.claude/logs/gates.jsonl.
for pg_var in ALLOW_MAIN ALLOW_LARGE_DIFF ALLOW_BOUNDARIES ALLOW_FOREIGN_BRANCH ALLOW_MERGE_INTEGRITY; do
  eval "pg_val=\${$pg_var:-}"
  if [ -n "$pg_val" ] && [ "$pg_val" != "0" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/hooks/lib/gate-log.js" ]; then
    node "$HOME/.claude/hooks/lib/gate-log.js" pre-push bypass "$pg_var=$pg_val" "$(pwd)" 2>/dev/null || true
  fi
done
if [ "${ALLOW_FOREIGN_BRANCH:-0}" != "1" ] && [ -n "$PUSH_REFS" ]; then
  my_email=$(git config user.email 2>/dev/null)
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    case "$remote_sha" in 0000000000000000000000000000000000000000) continue;; esac
    branch="${remote_ref#refs/heads/}"
    recent=$(git log --since="24 hours ago" --format="%ce" "$remote_sha" -n 20 2>/dev/null | grep -v "^${my_email}$" | sort -u | head -3 | tr '
' ' ')
    if [ -n "$recent" ]; then
      echo "[pre-push] UWAGA: galaz '$branch' ma w ostatnich 24 h commity od: ${recent}- to moze byc praca innej sesji. Push idzie dalej; jesli to nie Twoja galaz, przerwij i skoordynuj. Wylaczenie: ALLOW_FOREIGN_BRANCH=1." >&2
    fi
  done <<PG_REFS
$PUSH_REFS
PG_REFS
fi

# Scalenie bez zgubionych linii (2026-10-06: scalenie ours+theirs ucielo `}` w CSS, przeszlo lint/tsc/build): kazdy
# merge-commit spoza remote'ow — linie dodane w kazdym rodzicu musza byc w wyniku, CSS zbilansowany.
# Swiadome odrzucenie strony konfliktu: ALLOW_MERGE_INTEGRITY=1 (poziom A).
if [ "${ALLOW_MERGE_INTEGRITY:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/merge-integrity.js" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
    node "$HOME/.claude/bin/merge-integrity.js" --repo . --merges-of "$local_sha" >&2
    pg_mi_rc=$?
    # 1 = CSS rozbity w scaleniu nadal w pushu -> blokada; 2 = blad narzedzia/gita -> tylko ostrzezenie (nie zatrzymuje pracy).
    if [ "$pg_mi_rc" = "1" ]; then echo "[pre-push] merge-integrity: scalenie rozbilo CSS i nadal jest rozbity (wyzej). | BLOCKED: a merge left unbalanced CSS. Swiadomie: ALLOW_MERGE_INTEGRITY=1." >&2; exit 1; fi
    if [ "$pg_mi_rc" = "2" ]; then
      echo "[pre-push] merge-integrity: nie udalo sie sprawdzic scalen (blad narzedzia) — push idzie dalej." >&2
      [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] && node "$HOME/.claude/hooks/lib/gate-log.js" pre-push skipped "merge-integrity: blad narzedzia (exit 2)" "$(pwd)" 2>/dev/null
    fi
  done <<PG_MI_REFS
$PUSH_REFS
PG_MI_REFS
fi

[ "$ALLOW_MAIN" = "1" ] && exit 0

# Repo samego PG (~/.claude -> <github-owner>/<your-private-pg-repo>): main to kopia PG (bin/pg-sync.js push), bez PR-ow i CI.
# Wyjatek zdejmuje TYLKO blokade pushu na main — limit rozmiaru i granice modulow nizej dzialaja dalej (recenzja 2026-09-26).
# Cel sprawdzany po $2 = URL, pod ktory git faktycznie pcha (pushurl), nie po nazwie remote'a. Force-push blokuje bash-guard.
pg_main_ok=0
pg_main_why="main -> <github-owner>/<your-private-pg-repo> (kopia PG, pg-sync)"
pg_top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$pg_top" ] && [ -d "$HOME/.claude" ] && [ "$(cd "$pg_top" && pwd -P)" = "$(cd "$HOME/.claude" && pwd -P)" ] &&
   printf '%s' "$2" | grep -Eq '^(https://|git@)github\.com[:/]<github-owner>/<your-private-pg-repo>(\.git)?$'; then
  pg_main_ok=1
fi
# Repo tresci prowadzone przez codzienne zadania (sesje nauki, uzytkownik 2026-10-05): bez PR-ow i CI, agent dopisuje
# jedna sesje dziennie. Wyjatek tylko dla lokalnego klonu w ~/Documents/<repo> i pushurl na <github-owner>/<repo>.
# Po przejsciu na Linuksa blokada main zatrzymala te pushe na 3 dni (S85-S87 tylko lokalnie).
for content_repo in code-reading-quest mas-learning-system; do
  if [ -n "$pg_top" ] && [ "$(cd "$pg_top" && pwd -P)" = "$(cd "$HOME/Documents/$content_repo" 2>/dev/null && pwd -P)" ] &&
     printf '%s' "$2" | grep -Eq "^(https://([^@/]+@)?|git@)github\.com[:/]<github-owner>/$content_repo(\.git)?\$"; then
    pg_main_ok=1
    pg_main_why="main -> <github-owner>/$content_repo (dziennik nauki, zadanie dzienne)"
  fi
done

if [ -f package.json ] && grep -q "lovable-tagger" package.json 2>/dev/null; then
  exit 0   # legacy Lovable: push do main = deploy, przepuszczamy
fi

# Blizna PREPUSH-STDIN-CONSUMED-DEAD-GATE (2026-09-12): ta petla czytala GOLY stdin, ktory `PUSH_REFS="$(cat)"` wyzej
# juz zjadl -> 0 iteracji -> push na main przechodzil (empirycznie rc=0) przez 6 dni. Refy ZAWSZE z $PUSH_REFS.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$pg_main_ok" = "1" ]; then
        # Jak kazde obejscie: wpis w logu bramek (code-review 2026-09-26).
        command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] &&
          node "$HOME/.claude/hooks/lib/gate-log.js" pre-push bypass "$pg_main_why" "$(pwd)" 2>/dev/null
        continue
      fi
      echo "" >&2
      echo "[pre-push] ZABLOKOWANE: bezposredni push na main (standard flow: branch -> PR -> merge). | BLOCKED: direct push to main." >&2
      echo "[pre-push] Zrob / Do:  git checkout -b feature/nazwa && git push -u origin feature/nazwa" >&2
      echo "[pre-push] Awaryjny wyjatek / emergency escape (hotfix):  ALLOW_MAIN=1 git push" >&2
      exit 1
      ;;
  esac
done <<PG_REFS
$PUSH_REFS
PG_REFS

# Rozmiar zmiany (ta sama blizna: blok stal POD `exit 0` i nigdy sie nie wykonywal) (research 2026-09-06: duzy PR = slepa recenzja; marketplace-app #2 = 213 plikow, nikt nie zmergowal).
# Liczy tylko linie zrodlowe (bez lockfile/testow/docs/migracji). Wyjatek: ALLOW_LARGE_DIFF=1.
if [ "${ALLOW_LARGE_DIFF:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/diff-size-gate.js" ]; then
  if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    node "$HOME/.claude/bin/diff-size-gate.js" --base origin/main --max 400 || { echo "[pre-push] diff-size-gate: podziel zmiane na mniejsze PR-y. | BLOCKED: > 400 source lines vs origin/main, split the change. Wyjatek (migracja/generated): ALLOW_LARGE_DIFF=1." >&2; exit 1; }
  fi
fi

# Granice modulow (2026-09-12, pytanie o skale: „spojnosc sie rozjezdza"): NOWY cykl importow albo import wbrew warstwom
# z bloku json w docs/ARCHITECTURE.md = blok; stare cykle tylko ostrzegaja (dlugu nie sprzatamy z automatu). Wyjatek: ALLOW_BOUNDARIES=1.
if [ "${ALLOW_BOUNDARIES:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/module-boundaries.js" ]; then
  if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    node "$HOME/.claude/bin/module-boundaries.js" --base origin/main || { echo "[pre-push] module-boundaries: nowy cykl importow albo naruszenie warstw (docs/ARCHITECTURE.md). | BLOCKED: new import cycle or import against declared layers. Wyjatek z powodem w ADR: ALLOW_BOUNDARIES=1." >&2; exit 1; }
  fi
fi

exit 0
