#!/bin/sh
# Globalny pre-push (PG): blokuje BEZPOSREDNI push na main/master w projektach
# STANDARD (nowy flow: branch -> PR -> CI+review -> merge).
# Przechodza: stare projekty Lovable (lovable-tagger w package.json), tagi,
# inne branche, oraz awaryjnie: ALLOW_MAIN=1 git push


# Cudza galaz (retro 2026-09-06, petla 11): push na galaz, ktora w ciagu 24 h dostala commit z innego adresu niz moj,
# to wejscie w cudza prace (rownolegle sesje). Tylko OSTRZEZENIE, nie blokuje; wylaczenie: ALLOW_FOREIGN_BRANCH=1.
# Refy pushowane czytamy ze stdin RAZ do zmiennej, zeby reszta hooka mogla z nich korzystac.
PUSH_REFS="$(cat)"
# Audyt obejsc (landscape #5): kazde ustawione ALLOW_* = wpis `bypass` w ~/.claude/logs/gates.jsonl.
for pg_var in ALLOW_MAIN ALLOW_LARGE_DIFF ALLOW_BOUNDARIES ALLOW_FOREIGN_BRANCH ALLOW_MERGE_INTEGRITY; do
  eval "pg_val=\${$pg_var:-}"
  if [ -n "$pg_val" ] && [ "$pg_val" != "0" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/hooks/lib/gate-log.js" ]; then
    node "$HOME/.claude/hooks/lib/gate-log.js" pre-push bypass "$pg_var=$pg_val" "$(pwd)" 2>/dev/null || true
  fi
done
# Fala 0 (pg/designs/2026-11-01-fala-0-pomiar.md §11.1): kazde wyjscie != 0 zostawia w gates.jsonl `blocked` z nazwa bramki
# (pg_gate ustawiany tuz przed `exit 1`; nowe wyjscie bez nazwy = UNKNOWN, widoczne). Wczesniej 0 wpisow `blocked` z git-hookow
# na 24 567 (2026-10-21..11-01): bramka, ktora zatrzymala commit, byla w telemetrii niewidoczna. Status wyjscia bez zmian.
pg_on_exit() {
  pg_rc=$?
  if [ "$pg_rc" != "0" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/hooks/lib/gate-log.js" ]; then
    node "$HOME/.claude/hooks/lib/gate-log.js" pre-push blocked "rc=$pg_rc" "$(pwd)" "${pg_gate:-UNKNOWN}" 2>/dev/null || true
  fi
}
pg_gate=
trap pg_on_exit EXIT
if [ "${ALLOW_FOREIGN_BRANCH:-0}" != "1" ] && [ -n "$PUSH_REFS" ]; then
  my_email=$(git config user.email 2>/dev/null)
  while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    case "$remote_sha" in 0000000000000000000000000000000000000000) continue;; esac
    branch="${remote_ref#refs/heads/}"
    recent=$(git log --since="24 hours ago" --format="%ce" "$remote_sha" -n 20 2>/dev/null | grep -v "^${my_email}$" | sort -u | head -3 | tr '
' ' ')
    if [ -n "$recent" ]; then
      echo "[pre-push] UWAGA: galaz '$branch' ma w ostatnich 24 h commity od: ${recent}- to moze byc praca innej sesji. Push idzie dalej; jesli to nie Twoja galaz, przerwij i skoordynuj. Wylaczenie: ALLOW_FOREIGN_BRANCH=1." >&2
    fi
  done <<PG_REFS
$PUSH_REFS
PG_REFS
fi

# Scalenie bez zgubionych linii (2026-10-06: scalenie ours+theirs ucielo `}` w CSS, przeszlo lint/tsc/build): kazdy
# merge-commit spoza remote'ow — linie dodane w kazdym rodzicu musza byc w wyniku, CSS zbilansowany.
# Swiadome odrzucenie strony konfliktu: ALLOW_MERGE_INTEGRITY=1 (poziom A).
if [ "${ALLOW_MERGE_INTEGRITY:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/merge-integrity.js" ]; then
  while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
    node "$HOME/.claude/bin/merge-integrity.js" --repo . --merges-of "$local_sha" >&2
    pg_mi_rc=$?
    # 1 = CSS rozbity w scaleniu nadal w pushu -> blokada; 2 = blad narzedzia/gita -> tylko ostrzezenie (nie zatrzymuje pracy).
    if [ "$pg_mi_rc" = "1" ]; then echo "[pre-push] merge-integrity: scalenie rozbilo CSS i nadal jest rozbity (wyzej). | BLOCKED: a merge left unbalanced CSS. Swiadomie: ALLOW_MERGE_INTEGRITY=1." >&2; pg_gate=MERGE_INTEGRITY; exit 1; fi
    # kazde rc poza 0/1 (2 = blad narzedzia, >= 128 = smierc procesu) = ostrzezenie + slad (ADR-0008)
    if [ "$pg_mi_rc" != "0" ] && [ "$pg_mi_rc" != "1" ]; then
      echo "[pre-push] merge-integrity: nie udalo sie sprawdzic scalen (blad narzedzia, rc=$pg_mi_rc) — push idzie dalej." >&2
      [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] && node "$HOME/.claude/hooks/lib/gate-log.js" pre-push skipped "merge-integrity: blad narzedzia (exit $pg_mi_rc)" "$(pwd)" 2>/dev/null
    fi
  done <<PG_MI_REFS
$PUSH_REFS
PG_MI_REFS
fi

[ "$ALLOW_MAIN" = "1" ] && exit 0

# Repo samego PG (~/.claude -> <github-owner>/<your-private-pg-repo>): main to kopia PG (bin/pg-sync.js push), bez PR-ow i CI.
# Wyjatek zdejmuje TYLKO blokade pushu na main — limit rozmiaru i granice modulow nizej dzialaja dalej (recenzja 2026-09-26).
# Cel sprawdzany po $2 = URL, pod ktory git faktycznie pcha (pushurl), nie po nazwie remote'a. Force-push blokuje bash-guard.
pg_main_ok=0
pg_main_why="main -> <github-owner>/<your-private-pg-repo> (kopia PG, pg-sync)"
pg_top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$pg_top" ] && [ -d "$HOME/.claude" ] && [ "$(cd "$pg_top" && pwd -P)" = "$(cd "$HOME/.claude" && pwd -P)" ] &&
   printf '%s' "$2" | grep -Eq '^(https://|git@)github\.com[:/]<github-owner>/<your-private-pg-repo>(\.git)?$'; then
  pg_main_ok=1
fi
# Repo tresci prowadzone przez codzienne zadania (sesje nauki, uzytkownik 2026-10-05): bez PR-ow i CI, agent dopisuje
# jedna sesje dziennie. Wyjatek tylko dla lokalnego klonu w ~/Documents/<repo> i pushurl na <github-owner>/<repo>.
# Po przejsciu na Linuksa blokada main zatrzymala te pushe na 3 dni (S85-S87 tylko lokalnie).
for content_repo in code-reading-quest mas-learning-system; do
  if [ -n "$pg_top" ] && [ "$(cd "$pg_top" && pwd -P)" = "$(cd "$HOME/Documents/$content_repo" 2>/dev/null && pwd -P)" ] &&
     printf '%s' "$2" | grep -Eq "^(https://([^@/]+@)?|git@)github\.com[:/]<github-owner>/$content_repo(\.git)?\$"; then
    pg_main_ok=1
    pg_main_why="main -> <github-owner>/$content_repo (dziennik nauki, zadanie dzienne)"
  fi
done

if [ -f package.json ] && grep -q "lovable-tagger" package.json 2>/dev/null; then
  exit 0   # legacy Lovable: push do main = deploy, przepuszczamy
fi

# Blizna PREPUSH-STDIN-CONSUMED-DEAD-GATE (2026-09-12): ta petla czytala GOLY stdin, ktory `PUSH_REFS="$(cat)"` wyzej
# juz zjadl -> 0 iteracji -> push na main przechodzil (empirycznie rc=0) przez 6 dni. Refy ZAWSZE z $PUSH_REFS.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$pg_main_ok" = "1" ]; then
        # Jak kazde obejscie: wpis w logu bramek (code-review 2026-09-26).
        command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] &&
          node "$HOME/.claude/hooks/lib/gate-log.js" pre-push bypass "$pg_main_why" "$(pwd)" 2>/dev/null
        continue
      fi
      echo "" >&2
      echo "[pre-push] ZABLOKOWANE: bezposredni push na main (standard flow: branch -> PR -> merge). | BLOCKED: direct push to main." >&2
      echo "[pre-push] Zrob / Do:  git checkout -b feature/nazwa && git push -u origin feature/nazwa" >&2
      echo "[pre-push] Awaryjny wyjatek / emergency escape (hotfix):  ALLOW_MAIN=1 git push" >&2
      pg_gate=MAIN; exit 1
      ;;
  esac
done <<PG_REFS
$PUSH_REFS
PG_REFS

# Rozmiar zmiany (ta sama blizna: blok stal POD `exit 0` i nigdy sie nie wykonywal) (research 2026-09-06: duzy PR = slepa recenzja; marketplace-app #2 = 213 plikow, nikt nie zmergowal).
# Liczy tylko linie zrodlowe (bez lockfile/testow/docs/migracji). Wyjatek: ALLOW_LARGE_DIFF=1.
# Plan v3 L4 (2026-10-14): prog 400 -> 1500 (tylko giganty). 400 dawal ~110 blokad / 12 dni obchodzonych ALLOW (poziom A),
# a regula „ten sam temat = ta sama galaz/PR" naturalnie powieksza PR-y. Komunikat nie kaze dzielic jednego tematu.
if [ "${ALLOW_LARGE_DIFF:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/diff-size-gate.js" ]; then
  if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    node "$HOME/.claude/bin/diff-size-gate.js" --base origin/main --max 1500 || { echo "[pre-push] diff-size-gate: > 1500 linii zrodlowych vs origin/main — taki diff jest nie do zrecenzowania. Kilka niezaleznych tematow -> rozdziel; jeden temat (migracja, wygenerowany kod, duzy feature) -> ALLOW_LARGE_DIFF=1. | BLOCKED: > 1500 source lines vs origin/main; split only independent topics, one topic: ALLOW_LARGE_DIFF=1." >&2; pg_gate=LARGE_DIFF; exit 1; }
  fi
fi

# Granice modulow (2026-09-12, pytanie o skale: „spojnosc sie rozjezdza"): NOWY cykl importow albo import wbrew warstwom
# z bloku json w docs/ARCHITECTURE.md = blok; stare cykle tylko ostrzegaja (dlugu nie sprzatamy z automatu). Wyjatek: ALLOW_BOUNDARIES=1.
if [ "${ALLOW_BOUNDARIES:-0}" != "1" ] && command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/module-boundaries.js" ]; then
  if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    # exit 1 = werdykt (nowy cykl / warstwy) -> blok; exit 2 = blad narzedzia -> ostrzezenie (zalogowane jako skipped), nie blok
    mb_rc=0; node "$HOME/.claude/bin/module-boundaries.js" --base origin/main --from pre-push || mb_rc=$?
    if [ "$mb_rc" = "1" ]; then echo "[pre-push] module-boundaries: nowy cykl importow albo naruszenie warstw (docs/ARCHITECTURE.md). | BLOCKED: new import cycle or import against declared layers. Wyjatek z powodem w ADR: ALLOW_BOUNDARIES=1." >&2; pg_gate=BOUNDARIES; exit 1; fi
    # slad pisze HOOK (nie skrypt): pokrywa tez OOM/SIGKILL/timeout, gdy node nie zdazy nic zapisac (review r3 2026-10-18)
    if [ "$mb_rc" != "0" ]; then
      echo "[pre-push] module-boundaries: blad narzedzia (rc=$mb_rc) — granice NIE sprawdzone, push przepuszczony; slad w gates.jsonl (skipped). | WARNING: tool error, boundaries not checked." >&2
      [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] && node "$HOME/.claude/hooks/lib/gate-log.js" pre-push skipped "module-boundaries: blad narzedzia (exit $mb_rc)" "$(pwd)" 2>/dev/null
    fi
  fi
fi

# Kod „na zapas" (2026-10-26, pytanie uzytkownika o niepotrzebny kod): NOWY eksport TS/JS albo def/class Pythona bez zadnego
# uzycia w repo. OBSERVE (ADR-0008): ostrzezenie + `would_block` w gates.jsonl, push przechodzi. Blokada po incydencie.
if command -v node >/dev/null 2>&1 && [ -f "$HOME/.claude/bin/unused-export-gate.js" ]; then
  # Baza = galaz domyslna origin (origin/HEAD), potem main/master — repo z `master` tez jest mierzone (pg-review data r2).
  ue_base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
  for _b in "$ue_base" origin/main origin/master; do
    if [ -n "$_b" ] && git rev-parse --verify -q "$_b" >/dev/null 2>&1; then ue_base=$_b; break; fi
    ue_base=""
  done
  ue_log() { [ -f "$HOME/.claude/hooks/lib/gate-log.js" ] && node "$HOME/.claude/hooks/lib/gate-log.js" pre-push skipped "$1" "$(pwd)" 2>/dev/null; }
  if [ -n "$ue_base" ]; then
    ue_rc=0; ue_out=$(node "$HOME/.claude/bin/unused-export-gate.js" --base "$ue_base" --from pre-push 2>&1) || ue_rc=$?
    if [ "$ue_rc" = "1" ]; then
      echo "[pre-push] unused-export-gate (observe): nowe definicje bez uzycia — usun albo uzyj (YAGNI). Push przepuszczony. | WARNING: new unused definitions:" >&2
      printf '%s\n' "$ue_out" | head -20 >&2
    elif [ "$ue_rc" != "0" ]; then
      echo "[pre-push] unused-export-gate: blad narzedzia (rc=$ue_rc), nie sprawdzono. | WARNING: tool error." >&2
      # Slad tez z hooka: OOM/SIGKILL/timeout nie zdaza zalogowac z narzedzia (jak module-boundaries wyzej; pg-review ops r2).
      [ "$ue_rc" != "2" ] && ue_log "unused-export-gate: blad narzedzia (exit $ue_rc)"
    fi
  else
    # Brak bazy = observe nic nie mierzy — slad w telemetrii, zeby guard_health to widzial (pg-review 2026-10-26 ops).
    ue_log "unused-export-gate: brak galezi domyslnej origin"
  fi
fi

exit 0
