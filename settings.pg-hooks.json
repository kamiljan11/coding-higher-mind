{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/session-context.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__desktop-commander__start_process|mcp__desktop-commander__interact_with_process|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/bash-guard.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__desktop-commander__write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/memory-guard.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__desktop-commander__write_file|mcp__desktop-commander__edit_block|mcp__desktop-commander__move_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/edit-guard.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__((?!(?:[A-Z][A-Za-z0-9]*_)?(?:[gG]et|[lL]ist|[sS]earch|[rR]ead)(?:_|[A-Z]))\\w*(?:[sS]end|[rR]eply|[fF]orward|[dD]raft|[tT]rash|[dD]elete|[vV]acation|[eE]mpty_?[fF]older|[sS]ignature|[uU]pdateUser|update_display_name)\\w*|calendar_create_event|merge_pull_request|push_files|create_or_update_file|create_pull_request(?:_review)?|create_issue|update_issue|add_issue_comment|create_repository|fork_repository|reserve_booking|create_branch|update_pull_request(?:_branch)?|set_auto_merge|create_scheduled_task|update_scheduled_task)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/outbound-observe.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/precompact-snapshot.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/postcompact-summary.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/prompt-guard.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__desktop-commander__write_file|mcp__desktop-commander__edit_block",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/post-edit-check.js\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/post-bash-edit-check.js\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/loop-monitor.js\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/stop-gate.js\"",
            "timeout": 170
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/hooks/context-checkpoint.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{CLAUDE_DIR}}/hooks/auto-doc.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
