# Zmienne srodowiskowe — TYLKO NAZWY, zero wartosci (scorer R8). Wartosci: menedzer sekretow (Infisical/1Password/Doppler),
# na produkcji: Vercel env / Lovable Secrets. Kazda zmienna ma komentarz: co to jest i skad sie bierze.

# --- Srodowiska (PG L2, bramka `node ~/.claude/bin/env-ref-gate.js --repo .`) ---
# JEDYNA zmienna w tym pliku Z WARTOSCIA: ref PRODUKCYJNEGO projektu Supabase (20 znakow z https://<ref>.supabase.co).
# Ref NIE jest sekretem (jest w publicznym URL apki) — bez wartosci tutaj bramka nie wie, co jest prodem, i milczy
# (ops-reviewer 2026-09-12: „zero wartosci" unieszkodliwialo bramke). Alternatywa: `supabase link` (supabase/.temp/project-ref).
# Lokalny `.env.local`, `.env.development` i preview NIE moga wskazywac na ten ref — dev na prodzie = testy psuja dane klientow.
# Repo bez osobnego stagingu (prototyp bez uzytkownikow) deklaruje to jawnie w CLAUDE.md: `pg.single_env: true`.
SUPABASE_PROJECT_REF_PROD=wpiszrefprodukcyjny

# --- Supabase (klient; lokalnie ref STAGINGU / branchu, nigdy prod) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Integracje (nazwy jak w Infisical; brak = funkcja wylaczona, nie cichy fallback) ---
RESEND_API_KEY=
